# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pocket_planner?schema=public"

# JWT signing secret (use a long random string in production)
JWT_SECRET="change_me_to_a_long_random_secret"
JWT_EXPIRES_IN="7d"
JWT_REMEMBER_EXPIRES_IN="30d"

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# OpenAI — used only on the backend. Never expose this key in frontend code.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional: call the Python scikit-learn service when true
USE_PYTHON_ML="false"
ML_SERVICE_URL="http://localhost:8001"

# File uploads
MAX_UPLOAD_MB=5
